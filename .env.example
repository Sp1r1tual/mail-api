# ============================================================
# SERVER
# ============================================================
PORT=10000

# ============================================================
# CONNECTED SERVICES
# ============================================================
# Links in outgoing mail must start with one of these origins (API and client URLs)
ALLOWED_LINK_ORIGINS=http://localhost:5000,http://localhost:5173
# Must match MAIL_API_SECRET in pixel-place-api. Generate with: openssl rand -hex 32
MAIL_API_SECRET=<shared_secret>

# ============================================================
# SMTP (Mail)
# ============================================================
# Gmail: enable 2FA and generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=<your_email@gmail.com>
SMTP_PASSWORD=<your_app_password>
